NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://miniledger:miniledger@localhost:5432/miniledger?schema=public
APP_TIMEZONE=Asia/Kolkata

# JWT Configuration
JWT_ACCESS_SECRET=miniledger_super_secret_jwt_access_key_min_32_characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# OTP Configuration
OTP_HASH_SECRET=miniledger_super_secret_otp_hash_key_min_32_characters
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# OTP Delivery Channel (console | sms)
# Default is 'console', which prints the 6-digit OTP directly into the backend terminal.
# To swap later with SMS or another provider, implement OtpSender and set OTP_CHANNEL here.
OTP_CHANNEL=console
OTP_FALLBACK_TO_CONSOLE=true

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
