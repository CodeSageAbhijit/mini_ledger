NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://miniledger:miniledger@localhost:5432/miniledger?schema=public
APP_TIMEZONE=Asia/Kolkata

# JWT Configuration
JWT_ACCESS_SECRET=miniledger_super_secret_jwt_access_key_min_32_characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# OTP Configuration
OTP_HASH_SECRET=miniledger_super_secret_otp_hash_key_min_32_characters
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# OTP Delivery Channel (whatsapp | sms | console)
OTP_CHANNEL=console
OTP_FALLBACK_TO_CONSOLE=true

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=miniledger_otp
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
