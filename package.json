{
  "name": "miniledger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm run --workspace=@miniledger/shared build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspace=@miniledger/api test",
    "db:migrate": "npm run --workspace=@miniledger/api db:migrate",
    "db:seed": "npm run --workspace=@miniledger/api db:seed",
    "dev:api": "npm run --workspace=@miniledger/api dev",
    "dev:mobile": "npm run --workspace=@miniledger/mobile start"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "expo-av": "^16.0.8",
    "expo": "~57.0.31",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
